# FastAPI 本地服务
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_RELOAD=true
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8000,http://localhost:8000

# OpenAI 或 OpenAI 兼容服务（DeepSeek、智谱等可通过 Base URL 接入）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini

# Gemini API；GEMINI_API_KEY 优先，GOOGLE_API_KEY 作为兼容回退
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Google Vertex AI
# GOOGLE_APPLICATION_CREDENTIALS 应指向本机 ADC JSON；禁止提交该文件或真实路径
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
GOOGLE_VERTEX_MODEL_NAME=gemini-2.5-flash
VERTEX_API_KEY=
# 仅用于兼容旧配置；新前端会在每次运行中显式传入 provider
GOOGLE_VERTEX_AI=false

# LangGraph checkpoint；未配置或连接失败时自动使用进程内 MemorySaver
REDIS_URL=redis://127.0.0.1:6379/0

# 代码调用图；用户名和口令必须由本机填写
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=
NEO4J_PASSWORD=
NEO4J_PROJECT_ID=refactor-agent
